  "scenes": [
    {
      "id": "shuzhu",
      "seg": 0,
      "node": "樕䘄山",
      "title": "樕䘄山 · 启程",
      "kicker": "东山经 · 次一经",
      "quote": "东山经之首，曰樕䘄之山，临于西海。——《山海经》",
      "narration": "从这里向东，凡十二山，三千六百里。北望 Espresso…不，北望海水，第一程沿水而行。",
      "beast": "shanyu"
    },
    {
      "id": "congzhuang",
      "seg": 0,
      "node": "栒状山",
      "title": "栒状山 · 从从",
      "kicker": "次一经 · 第一兽",
      "quote": "有兽焉，其状如犬，六足，其鸣自詨，见则天下大穰。——《东山经》",
      "narration": "六足的从从出现的那一年，天下大熟。路上的第一个预兆，竟是丰收。",
      "beast": "congcong"
    },
    {
      "id": "taishan",
      "seg": 0,
      "node": "泰山",
      "title": "泰山 · 收束",
      "kicker": "次一经 · 终点",
      "quote": "环水出焉，东流注于江，其中多水玉。——《东山经》",
      "narration": "凡十二山，行三千六百里。第一程在泰山脚下收束，河神皆人身龙首。向北，进入密林。",
      "beast": "dongdong"
    },
    {
      "id": "kongsang",
      "seg": 1,
      "node": "空桑山",
      "title": "空桑山 · 入林",
      "kicker": "东山经 · 次二经",
      "quote": "又南三百里，曰空桑之山，无草木，冬夏有雪。——《山海经》",
      "narration": "空桑——神农、颛顼之地。冬夏有雪的山，是第二程的门。林中兽迹渐多，预兆一个比一个紧。",
      "beast": "lingling"
    },
    {
      "id": "yueyu",
      "seg": 1,
      "node": "余峨山",
      "title": "余峨山 · 犰狳",
      "kicker": "次二经 · 灾异之一",
      "quote": "有兽焉，其状如菟而鸟喙，鸱目蛇尾，见则螽蝗为败。——《东山经》",
      "narration": "犰狳走过之处，螽蝗成灾。灾异的序曲从这里响起。",
      "beast": "qiuyu"
    },
    {
      "id": "gengshan",
      "seg": 1,
      "node": "耿山",
      "title": "耿山 · 朱獳",
      "kicker": "次二经 · 灾异之二",
      "quote": "有兽焉，其状如狐而鱼翼，其音如獳，见则其国有恐。——《东山经》",
      "narration": "水碧生于山下，朱獳鸣于山间。它开口叫自己名字的时候，国中将有恐惧。",
      "beast": "zhuru"
    },
    {
      "id": "beishan",
      "seg": 1,
      "node": "碷山",
      "title": "碷山 · 絜钩",
      "kicker": "次二经 · 灾异之三",
      "quote": "有兽焉，其状如凫而鼠尾，善登木，见则县多土功。——《东山经》",
      "narration": "蝗灾、国恐、土功——三兽三兆，密林的尽头是一个个预言。向东，海岸已在风里。",
      "beast": "xiegou"
    },
    {
      "id": "shihu",
      "seg": 2,
      "node": "尸胡山",
      "side": "right",
      "panel": "bottom-left",
      "title": "尸胡山 · 离岸",
      "kicker": "东山经 · 次三经",
      "quote": "又南水行八百里，曰尸胡之山，其上多金玉，其下多蒺藜。——《山海经》",
      "narration": "从这里不再有陆路。船离岸的时候，山神换了面孔——人身羊角，海的神。",
      "beast": "yuhu"
    },
    {
      "id": "zhizhong",
      "seg": 2,
      "node": "跂踵山",
      "side": "left",
      "title": "跂踵山 · 鮯鮯",
      "kicker": "次三经 · 六足奇鱼",
      "quote": "有水焉，其中多鮯鮯之鱼，其状如鸡而赤毛，三尾六足四首，其音如鹊，见则其邑大旱。——《东山经》",
      "narration": "方圆二百里不生草木，泽中却游着三尾六足四首的怪鱼，啼声如鹊，现则大旱。",
      "beast": "gaigai"
    },
    {
      "id": "mouyu",
      "seg": 2,
      "node": "踇隅山",
      "side": "right",
      "title": "踇隅山 · 风中终点",
      "kicker": "次三经 · 收束",
      "quote": "有兽焉，其状如牛而马尾，其名曰精精，其鸣自詨。——《东山经》",
      "narration": "精精鸣于踇隅，海风止于无皋。第三程的水路走完，前方是海中的岛屿。",
      "beast": "jingjing"
    },
    {
      "id": "beihao",
      "seg": 3,
      "node": "北号山",
      "side": "right",
      "title": "北号山 · 临海",
      "kicker": "东山经 · 次四经",
      "quote": "又南三百里，曰北号之山，临于北海。——《山海经》",
      "narration": "最后一程从海岛开始。猲狙与鬿雀同栖一山，凶兽的浓度在这里最高。",
      "beast": "juzu"
    },
    {
      "id": "nuzheng",
      "seg": 3,
      "node": "女烝山",
      "side": "right",
      "title": "女烝山 · 薄鱼",
      "kicker": "次四经 · 凶兆",
      "quote": "石膏水出焉，其中多薄鱼，见则天下大旱。——《东山经》",
      "narration": "薄鱼一现，天下大旱。岛上的预言越来越重。",
      "beast": "boyu"
    },
    {
      "id": "shanshan",
      "seg": 3,
      "node": "剡山",
      "title": "剡山 · 合窳",
      "kicker": "次四经 · 凶兆",
      "quote": "有兽焉，其状如彘而人面，黄身而赤尾，其音如婴啼，见则天下大水。——《东山经》",
      "narration": "人面的合窳啼哭如婴儿，它出现的地方洪水滔天。最后一只凶兽之后——转机。",
      "beast": "heyu"
    },
    {
      "id": "qinshan",
      "seg": 3,
      "node": "钦山",
      "side": "right",
      "title": "钦山 · 当康",
      "kicker": "次四经 · 大穰",
      "quote": "有兽焉，其状如豚而有牙，其名曰当康，其鸣自詨，见则天下大穰。——《山海经》",
      "narration": "凶过之后，吉来收尾。当康的叫声响起的那一年，天下大熟。全经在此停住。",
      "beast": "dangkang"
    }
