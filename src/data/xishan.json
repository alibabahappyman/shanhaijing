  "scenes": [
    {
      "id": "qianwei",
      "seg": 0,
      "node": "钱来山",
      "title": "钱来山 · 西行起点",
      "kicker": "西山经 · 次一经",
      "quote": "西山经华山之首，曰钱来之山，其上多松，其下多洗石。——《山海经》",
      "narration": "东行止步，转身向西。华山为首，凡十九山，二千九百五十七里。山上有松，山下有洗石，可以澡浴去垢。",
      "beast": "juanyang"
    },
    {
      "id": "taihua",
      "seg": 0,
      "node": "太华山",
      "title": "太华山 · 肥遗",
      "kicker": "次一经 · 凶兆之首",
      "quote": "有蛇焉，名曰肥遗，六足四翼，见则天下大旱。——《西山经》",
      "narration": "太华之山，削成而四方，高五千仞。六足四翼的肥遗一现身，天下就要大旱。西行的第一个凶兆。",
      "beast": "feiyi"
    },
    {
      "id": "yuanci",
      "seg": 0,
      "node": "羭次山",
      "title": "羭次山 · 鸾鸟",
      "kicker": "次一经 · 祥瑞",
      "quote": "有鸟焉，其状如翟而五采文，见则天下安宁，名曰鸾鸟。——《西山经》",
      "narration": "羭次山多嚚鸟。五采文羽的鸾鸟出现，天下安宁。一路凶兆之后，第一次遇到吉兆。",
      "beast": "luanniao"
    },
    {
      "id": "huangshan",
      "seg": 0,
      "node": "黄山",
      "title": "黄山 · 鹦鹉",
      "kicker": "次一经 · 能言鸟",
      "quote": "有鸟焉，其状如鸮，青羽赤喙，人舌能言，名曰鹦鹉。——《西山经》",
      "narration": "黄山多竹箭，盼水出于此。青羽赤喙的鹦鹉有人的舌头，西行路上第一次听见山说话。",
      "beast": "yingwu"
    },
    {
      "id": "lutai",
      "seg": 1,
      "node": "鹿台山",
      "title": "鹿台山 · 凫徯",
      "kicker": "次二经 · 人面鸟",
      "quote": "有鸟焉，其状如雄鸡而人面，名曰凫徯，其鸣自叫也，见则有兵。——《西山经》",
      "narration": "鹿台之山，其上多白玉，其下多银。人面雄鸡凫徯叫着自己的名字，它出现之处，将有战事。",
      "beast": "fuxi"
    },
    {
      "id": "xiaoci",
      "seg": 1,
      "node": "小次山",
      "title": "小次山 · 朱厌",
      "kicker": "次二经 · 兵兆",
      "quote": "有兽焉，其状如猿，而白首赤足，名曰朱厌，见则大兵。——《西山经》",
      "narration": "小次山多白玉。白首赤足的朱厌一出，天下大兵。与凫徯前后呼应，兵兆成双。",
      "beast": "zhuyan"
    },
    {
      "id": "huaijiang",
      "seg": 2,
      "node": "槐江山",
      "title": "槐江山 · 英招",
      "kicker": "次三经 · 天帝平圃",
      "quote": "有神焉，其状如黄囊，赤如丹火，六足四翼，浑敦无面目，是识歌舞，实惟帝江也。——《西山经》",
      "narration": "第三程崇吾山至翼望山，凡二十三山，最密的一程。槐江山实惟帝之平圃，神英招司之：马身人面，虎文鸟翼，徇于四海。",
      "beast": "yingzhao"
    },
    {
      "id": "kunlun",
      "seg": 2,
      "node": "昆仑丘",
      "title": "昆仑丘 · 陆吾",
      "kicker": "次三经 · 帝之下都",
      "quote": "昆仑之丘，是实惟帝之下都，神陆吾司之。其神状虎身而九尾，人面而虎爪。——《西山经》",
      "narration": "昆仑之丘，天帝在人间的都城。神陆吾司之：虎身九尾，人面虎爪，管理天之九部。土蝼与钦原在山中，鸾鸟与凤鸟在林间。",
      "beast": "luwu"
    },
    {
      "id": "yushan",
      "seg": 2,
      "node": "玉山",
      "title": "玉山 · 西王母",
      "kicker": "次三经 · 王母之山",
      "quote": "玉山，是西王母所居也。——《西山经》",
      "narration": "玉山是西王母的居所。她豹尾虎齿而善啸，蓬发戴胜，司天之厉及五残。三青鸟为她取食。山中有狡兽，见则其国大穰。",
      "beast": "xiwangmu"
    },
    {
      "id": "zhang'e",
      "seg": 2,
      "node": "章莪山",
      "title": "章莪山 · 毕方",
      "kicker": "次三经 · 火兆",
      "quote": "有鸟焉，其状如鹤，一足，赤文青质而白喙，名曰毕方，其鸣自叫也，见则其邑有讹火。——《西山经》",
      "narration": "章莪之山多碧玉。独脚的毕方鸟，青羽赤纹白喙，它叫着自己的名字出现时，城中会有怪火。",
      "beast": "bifang"
    },
    {
      "id": "tianshan",
      "seg": 2,
      "node": "天山",
      "title": "天山 · 帝江",
      "kicker": "次三经 · 浑敦之歌",
      "quote": "有神焉，其状如黄囊，赤如丹火，六足四翼，浑敦无面目，是识歌舞，实惟帝江也。——《西山经》",
      "narration": "天山多金玉，有青雄黄。神帝江状如黄囊，赤如丹火，六足四翼，没有面目却懂得歌舞。西行至此，听一次没有脸的神唱歌。",
      "beast": "dijiang"
    },
    {
      "id": "wenyao",
      "seg": 2,
      "node": "泰器山",
      "title": "泰器山 · 文鳐鱼",
      "kicker": "次三经 · 飞鱼",
      "quote": "有鱼焉，其状如鲤，鱼身而鸟翼，苍文而白首赤喙，见则天下大穰。——《西山经》",
      "narration": "泰器山多文石。观水出焉，西流注于流沙。文鳐鱼鸟翼苍纹，常行西海，游于东海，以夜飞。它出现的那一年，天下丰收。",
      "beast": "wenyao"
    },
    {
      "id": "yanzi",
      "seg": 2,
      "node": "崦嵫山",
      "title": "崦嵫山 · 蓐收",
      "kicker": "次三经 · 日落之山",
      "quote": "崦嵫之山，苕水出焉，西流注于海。神蓐收司之。——《西山经》",
      "narration": "崦嵫是日入之山，第三程在蓐收司掌的日落之地收束。有兽焉，马身龙首鸟翼人面蛇尾，名曰孰湖。向西，最后一程。",
      "beast": "rushou"
    },
    {
      "id": "guishan",
      "seg": 3,
      "node": "邽山",
      "title": "邽山 · 穷奇",
      "kicker": "次四经 · 四凶",
      "quote": "有兽焉，其状如牛，猬毛，音如獆狗，名曰穷奇，是食人。——《西山经》",
      "narration": "邽山之水出焉，南流注于洋水。穷奇状如牛而有猬毛，声如嚎狗，是四凶之一。濛水多黄贝，蠃鱼鱼身鸟翼，见则邑有大水。",
      "beast": "qiongqi"
    },
    {
      "id": "yanzi4",
      "seg": 3,
      "node": "崦嵫山",
      "title": "崦嵫山 · 孰湖",
      "kicker": "次四经 · 终点",
      "quote": "有兽焉，其状如马而鸟翼，人面蛇尾，嗜好举人，名曰孰湖。——《西山经》",
      "narration": "四程在崦嵫山收束。孰湖马身鸟翼，人面蛇尾，喜欢把人举起来。凡十九山，三千六百八十里，其祠之礼皆用一白狗祈，糈以稌米。西山经终。",
      "beast": "shuhu"
    }
  ],
